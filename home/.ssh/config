# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

Host *.compute.amazonaws.com
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  User ec2-user
  LogLevel QUIET

Host *.fnal.gov
   GSSAPIAuthentication yes
   GSSAPIDelegateCredentials yes
   StrictHostKeyChecking no
   UserKnownHostsFile /dev/null

Host github.com
  Hostname ssh.github.com
  Port 443
  IdentityFile ~/.ssh/bengal.pem

Host icc
    ServerAliveInterval 300
    ServerAliveCountMax 2
    HostName cc-login.campuscluster.illinois.edu
    User bengal1


Host bi-bic
    HostName bi-bic-gdp-lnx.bic.beckman.illinois.edu
    User bengal1
    ForwardAgent yes
    IdentityFile ~/.ssh/bi-bic

Host git.ncsa.illinois.edu
	HostName git.ncsa.illinois.edu
	PreferredAuthentications publickey
	IdentityFile ~/.ssh/gitlab2026

Host pri01
    HostName pri01.prairie.illinois.edu
    User bengal1
    IdentityFile ~/.ssh/pri
